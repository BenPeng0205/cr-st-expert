/// 功能    : 限速函数
/// 库依赖  : Standard

{attribute 'hide_all_locals'}
FUNCTION F_LimitSpeed : INT
VAR_INPUT
    iValue              : INT := 0;     // 输入速度 [rpm]
    iMin                : INT := 0;     // 最小值
    iMax                : INT := 0;     // 最大值
END_VAR

// === IMPLEMENTATION ===

/// =======================================================================
/// 名称      : F_LimitSpeed
/// 功能      : 将速度请求限制在允许范围内
/// 库依赖    : Standard
/// =======================================================================
/// 使用说明  : 1. 调用方负责传入已确认单位的速度值
///           : 2. 函数只做无状态限幅，不保存跨周期状态
/// =======================================================================
// LIMIT 只做纯函数限幅，避免调用方在多个 POU 中重复编写边界判断。
F_LimitSpeed := LIMIT(
    MN := iMin,
    IN := iValue,
    MX := iMax
    );
